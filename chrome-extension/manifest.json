{
  "manifest_version": 3,
  "name": "BrandLint",
  "version": "1.0",
  "description": "Analyze any portfolio or personal site with BrandLint — personal brand intelligence in one click.",
  "permissions": ["activeTab"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "BrandLint — Analyze this page",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "host_permissions": [
    "http://localhost:3000/*"
  ]
}
